+"""agendas: one agenda per meeting, with the AI suggestion it came from
+
+Revision ID: 0003
+Revises: 0002
+Create Date: 2026-10-27
+"""
+
+from collections.abc import Sequence
+
+import sqlalchemy as sa
+from sqlalchemy.dialects import postgresql
+
+from alembic import op
+
+revision: str = "0003"
+down_revision: str | None = "0002"
+branch_labels: str | Sequence[str] | None = None
+depends_on: str | Sequence[str] | None = None
+
+
+def upgrade() -> None:
+    op.create_table(
+        "agendas",
+        sa.Column(
+            "meeting_id",
+            sa.Uuid(),
+            sa.ForeignKey("meetings.id", ondelete="CASCADE"),
+            primary_key=True,
+        ),
+        sa.Column(
+            "items", postgresql.JSONB(), nullable=False, server_default=sa.text("'[]'::jsonb")
+        ),
+        sa.Column(
+            "action_items",
+            postgresql.JSONB(),
+            nullable=False,
+            server_default=sa.text("'[]'::jsonb"),
+        ),
+        sa.Column("ai_suggestion", postgresql.JSONB(), nullable=True),
+        sa.Column(
+            "updated_at", sa.DateTime(timezone=True), server_default=sa.func.now(), nullable=False
+        ),
+    )
+
+
+def downgrade() -> None:
+    op.drop_table("agendas")
