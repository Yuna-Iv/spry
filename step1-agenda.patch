+def agenda_payload(**overrides) -> dict:
+    payload = {
+        "items": [
+            {"topic": "Нові тарифи Pro", "owner": "Олена", "minutes": 15},
+            {"topic": "Фідбек від клієнтів", "owner": "Taras", "minutes": None},
