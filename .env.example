POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth (Cognito) ---
# Filled in by `make infra-env` from the Terraform outputs (public IDs, not secrets). Local runs
# use the same user pool as AWS. The backend only accepts ID tokens from this pool and app client.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE_ENABLED=false
# Google sign-in is configured in Terraform: google_client_id in infra/terraform.tfvars and the
# secret as the sensitive variable google_client_secret of the HCP Terraform workspace. Redirect
# URI of the Google OAuth client: https://<COGNITO_DOMAIN>/oauth2/idpresponse.

# --- AWS deployment (make deploy-backend) ---
# Credentials of an IAM user allowed to manage CloudFormation, Lambda, EC2/VPC, RDS, ECR,
# IAM roles, SSM Parameter Store, S3, CloudFront, CloudWatch Logs, and for a custom domain
# ACM and Route 53. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Prefix for all AWS resource and stack names; every resource is tagged PROJECT_NAME=<this>
PROJECT_NAME=new-project
# Extra origins allowed to call the deployed API, comma-separated. The CloudFront address
# and the custom domain are added automatically.
CORS_ORIGINS_AWS=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512

# --- Custom domain (make add-domain, after make deploy) ---
# Host name for the frontend, e.g. app.example.com. Leave empty for the *.cloudfront.net address.
DOMAIN_NAME=
# Optional Route 53 hosted zone id of DOMAIN_NAME (e.g. Z0123456789ABC). If set, the DNS records
# are created for you; otherwise make add-domain prints the records to add at your DNS provider.
HOSTED_ZONE_ID=
# Host name for the backend, e.g. api.example.com (make add-api-domain, after make add-domain).
# Leave empty to call the Lambda function URL directly.
API_DOMAIN_NAME=

# --- Weekly report (make report-now, make report-ls, make report-logs) ---
# The report itself (schedule, email address, fail week) is configured in Terraform:
# infra/terraform.tfvars and the variables of the HCP Terraform workspace.

# --- Agenda parser on your laptop (make llm-hello, make parse, make dev-parser) ---
# The deployed parser takes the same settings from infra/terraform.tfvars.
# The Claude model on Amazon Bedrock, and the region that serves it (it may differ from AWS_REGION:
# the parser runs outside the VPC and reaches Bedrock over the internet). Model access is per region.
PARSER_MODEL=anthropic.claude-opus-5-5
BEDROCK_REGION=us-east-1
# mantle (bedrock-mantle: current models) or runtime (bedrock-runtime: older ones, e.g. Haiku 4.5,
# with inference-profile ids such as us.anthropic.claude-haiku-4-5-20251001-v1:0).
BEDROCK_API=mantle
# How hard the model thinks: low ... max. "none" for models without the setting (Haiku 4.5).
PARSER_EFFORT=low
# true: `make dev-parser` returns a fixed agenda after 3 s without calling the model.
PARSER_FAKE=
